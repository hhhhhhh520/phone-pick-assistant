# ===========================================
# 手机选购助手 - 生产环境变量模板
# ===========================================
# 复制此文件为 .env.production 并填写实际值
# cp .env.production.example .env.production

# -------------------------------------------
# LLM配置 (必填)
# -------------------------------------------
# DeepSeek API密钥 - 从 https://platform.deepseek.com 获取
# ⚠️ 安全警告: 请勿将实际密钥提交到 Git
DEEPSEEK_API_KEY=your-production-api-key-here

# DeepSeek API基础URL
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# LLM模型参数
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# -------------------------------------------
# 数据库配置
# -------------------------------------------
DATABASE_URL=sqlite:///./backend/data/phones.db

# -------------------------------------------
# 应用配置
# -------------------------------------------
APP_ENV=production
LOG_LEVEL=WARNING

# -------------------------------------------
# CORS配置 (重要 - 生产环境必须限制)
# -------------------------------------------
# 替换为你的实际域名
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -------------------------------------------
# 上下文配置
# -------------------------------------------
MAX_CONTEXT_MESSAGES=10
MAX_CONTEXT_TOKENS=4000
MAX_MESSAGE_LENGTH=500

# -------------------------------------------
# 部署配置 (CI/CD 使用)
# -------------------------------------------
# DEPLOY_HOST=your-server-ip
# DEPLOY_USER=deploy
# DEPLOY_PATH=/opt/phone-assistant