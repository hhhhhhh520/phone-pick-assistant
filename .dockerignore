# Docker 忽略文件
# 减少构建上下文大小，加快构建速度

# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Node
frontend/node_modules/
frontend/dist/
frontend/.npm/

# 数据库备份
*.db.bak
*.db.gz
backups/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# 日志
*.log
logs/

# 环境变量（敏感信息）
.env
.env.local
.env.*.local

# 测试
.pytest_cache/
.coverage
htmlcov/

# 文档
docs/
*.md
!README.md

# 其他
.DS_Store
Thumbs.db
*.tmp
*.temp