# Git 属性配置
# 确保 Shell 脚本在 Windows/Linux 上换行符正确

# Shell 脚本使用 LF 换行符
*.sh text eol=lf

# Python 文件使用 LF 换行符
*.py text eol=lf

# JavaScript/TypeScript 使用 LF 换行符
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# 配置文件使用 LF 换行符
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Markdown 使用 LF 换行符
*.md text eol=lf

# Windows 批处理文件使用 CRLF
*.bat text eol=cRLF
*.cmd text eol=cRLF